  "typography": {
    "families": {
      "display": "Space Grotesk",
      "body": "Inter",
      "arabic": "Noto Sans Arabic",
      "code": "ui-monospace"
    },
    "scale": {
      "caption": 12,
      "label": 14,
      "body": 16,
      "lead": 20,
      "h3": 24,
      "h2": 36,
      "h1": 56,
      "display": 80
    },
    "lineHeight": {
      "tight": 1.08,
      "heading": 1.18,
      "body": 1.6
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "spacing": {
    "unit": 4,
    "steps": [
      0,
      4,
      8,
      12,
      16,
      20,
      24,
      32,
      40,
      48,
      64,
      80,
      96,
      128
    ]
  },
  "radius": {
    "none": 0,
    "small": 4,
    "medium": 8,
    "large": 12
  },
  "elevation": {
    "none": "none",
    "raised": "0 8px 24px rgb(0 0 0 / .14)",
    "overlay": "0 24px 64px rgb(0 0 0 / .28)"
  },
  "border": {
    "width": 1,
    "strongWidth": 2
  },
  "breakpoints": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280
  },
  "motion": {
    "fastMs": 120,
    "standardMs": 180,
    "reduceMs": 0
  },
  "charts": {
    "lineWidth": 2,
    "minimumContrast": 3,
    "seriesPatterns": [
      "solid",
      "dash 6 4",
      "dash 2 3",
      "dash 10 3 2 3"
    ]
  },
  "risk": {
    "unknown": "neutral",
    "review": "warning",
    "blocked": "negative",
